# Entorno local: development | production
APP_ENV=development
FLASK_DEBUG=1
FLASK_SECRET_KEY=CAMBIAR_POR_UN_VALOR_ALEATORIO_LARGO
AUDIT_HMAC_KEY=OTRO_VALOR_ALEATORIO_LARGO
SESSION_MINUTES=30

# Microsoft Entra ID
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_SECRET=NO_SUBIR_A_GIT
ENTRA_REDIRECT_URI=http://localhost:5000/auth/callback
ENTRA_POST_LOGOUT_URI=http://localhost:5000/

# Desarrollo rápido con SQLite
DATABASE_URL=sqlite:///secureauth.db

# Azure SQL con identidad administrada (producción). Codifica espacios como +.
# DATABASE_URL=mssql+pyodbc://@TU-SERVIDOR.database.windows.net/secureauth?driver=ODBC+Driver+18+for+SQL+Server&authentication=ActiveDirectoryMsi&Encrypt=yes&TrustServerCertificate=no

# Blob Storage: recomendado con identidad administrada
AZURE_STORAGE_ACCOUNT_URL=https://TUCUENTA.blob.core.windows.net
AZURE_STORAGE_CONTAINER=product-images
# Alternativa solo para desarrollo, guardada en Key Vault/App Settings en producción:
# AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=...

# Producción con varias instancias: Azure Cache for Redis
# RATELIMIT_STORAGE_URI=redis://:PASSWORD@HOST:6380/0?ssl=true
